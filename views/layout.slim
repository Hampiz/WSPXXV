/ Standard HTML5 doctype declaration
doctype html
html
  head
    / Set character encoding to UTF-8 for proper Swedish character support (å, ä, ö)
    meta charset="utf-8"
    / Make the page responsive on mobile devices
    meta name="viewport" content="width=device-width, initial-scale=1"
    title Inköpslista
    / Link to external stylesheet for page styling
    link rel="stylesheet" href="/design.css"
  body
    / Top navigation bar
    nav.navbar
      h1 Makeyourgrocerylist
      / Navigation links list
      ul.nav-links
        / Check if the user is logged in using the logged_in? helper
        - if logged_in?
          / Display a greeting with the user's username
          li Hej, #{current_user['username']}!
          li
            / Logout form — uses POST to /logout to clear the session
            form action="/logout" method="post" style="display:inline;"
              button type="submit" Logga ut
        - else
          / If not logged in, show links to login and register pages
          li
            a href="/login" Logga in
          li
            a href="/register" Skapa ett konto
    main
      / Render the content of the current page/view here
      == yield